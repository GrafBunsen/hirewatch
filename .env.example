# Copy to .env and fill in. See docs/configuration.md for the full reference.

# --- Mail (required) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=you@example.com
MAIL_TO=recipient@example.com

# --- Scheduling / state (optional; defaults shown) ---
# HIREWATCH_LOOP=true
# HIREWATCH_SCHEDULE_AT=08:00
# HIREWATCH_STATE_PATH=state.json
# HIREWATCH_SOURCES_DIR=sources

# --- LLM (only for `ai` sources or a `criterion`) ---
# LLM_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3
# LLM_API_KEY=
# LLM_PROMPT_OVERRIDE=
